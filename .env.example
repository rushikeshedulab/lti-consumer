# ---------------------------------------------------------------------------
# CONSUMER LMS  (LTI 1.3 role: PLATFORM)
# ---------------------------------------------------------------------------
PORT=4001
CONSUMER_BASE_URL=http://localhost:4001

# This value is the `iss` claim of every id_token this platform signs.
# It must match exactly what the provider has registered.
LTI_ISSUER=http://localhost:4001

DATABASE_URL=postgres://lti:lti@localhost:5433/lti_consumer

# RSA keypair used to SIGN the LTI id_token. Backend-only; the public half is
# published at /.well-known/jwks.json for the tool to verify against.
LTI_PRIVATE_KEY_PATH=./keys/private.pem
LTI_PUBLIC_KEY_PATH=./keys/public.pem
LTI_KEY_ID=platform-key-1

# The tool registration this platform issues (must match the provider's .env)
LTI_CLIENT_ID=edulab-content-provider
LTI_DEPLOYMENT_ID=deployment-fin-001
TOOL_NAME=EduLab Content Provider
TOOL_BASE_URL=http://localhost:4000
TOOL_LOGIN_INITIATION_URL=http://localhost:4000/lti/login
TOOL_REDIRECT_URIS=http://localhost:4000/lti/launch
TOOL_JWKS_URL=http://localhost:4000/.well-known/jwks.json

# Session cookie signing secret for the demo student login
SESSION_SECRET=change-me-consumer-session-secret

# Demo login password (all seeded users share it)
DEMO_PASSWORD=demo1234

# Lifetime of the id_token this platform mints (seconds)
ID_TOKEN_TTL_SECONDS=300
# Lifetime of access tokens issued from the token endpoint (seconds)
ACCESS_TOKEN_TTL_SECONDS=3600
